<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="WiantexApp.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Bg">#0B0A14</Color><Color x:Key="Panel">#151222</Color><Color x:Key="Panel2">#1B1730</Color>
      <Color x:Key="Accent">#8B5CF6</Color><Color x:Key="Accent2">#4F46E5</Color><Color x:Key="Text">#F7F5FF</Color><Color x:Key="Muted">#9B95AF</Color>
      <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Arial"/></Style>
      <Style TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Panel2}"/><Setter Property="TextColor" Value="{StaticResource Text}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,10"/></Style>
      <Style TargetType="Entry"><Setter Property="BackgroundColor" Value="{StaticResource Panel}"/><Setter Property="TextColor" Value="{StaticResource Text}"/><Setter Property="PlaceholderColor" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,6"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
